#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>


#define DEF 0
#define FUN 1


&lt { quick_tap_ms = <220>; };

&mt { quick_tap_ms = <220>; };


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE     &none         &lt 1 LANG1   
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE     &none         &lt 1 LANG1   

            >;
        };

        function_layer {
            bindings = <
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE     &none         &lt 1 LANG1   
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE     &none         &lt 1 LANG1  
            >;
        };

        layer_2 {
            bindings = <
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE     &none         &lt 1 LANG1   
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE     &none         &lt 1 LANG1  
            >;
        };

        layer_3 {
            bindings = <
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE     &none         &lt 1 LANG1   
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE     &none         &lt 1 LANG1  
            >;
