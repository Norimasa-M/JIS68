#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define FUN 1

&lt { quick_tap_ms = <220>; };

&mt { quick_tap_ms = <220>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 1 ESCAPE      &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6
&kp TAB           &kp Q         &kp W          &kp E         &kp R         &kp T         &kp Y
&kp LEFT_CONTROL  &kp A         &kp S          &kp D         &kp F         &kp G         &kp H
&kp LEFT_SHIFT    &kp Z         &kp X          &kp C         &kp V         &kp B         &kp N
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT   &kp LEFT_ALT  &lt 1 LANG2   &kp SPACE
&kp N7            &kp N8        &kp N9         &kp N0        &kp MINUS     &kp EQUAL     &kp INT3
&kp U             &kp I         &kp O          &kp P         &kp LBKT      &kp RBKT      &kp BACKSPACE
&kp J             &kp K         &kp L          &kp SEMI      &kp SQT       &kp NUHS      &kp RET
&kp M             &kp COMMA     &kp PERIOD     &kp SLASH     &kp INT1      &kp UP        &mo 2
&kp LANG1                       &kp RIGHT_ALT  &kp RCTRL     &kp LEFT      &kp DOWN      &kp RIGHT
            >;
        };

        function_layer {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3   &kp F4   &kp F5   &kp F6
&trans  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans   &trans   &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &kp DEL
&trans  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans
&trans          &trans  &trans   &trans   &trans   &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &kp KP_N1  &trans  &trans  &trans
&trans          &trans  &trans     &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
